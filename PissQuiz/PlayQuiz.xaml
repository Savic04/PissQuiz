<Window x:Class="PissQuiz.PlayQuiz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spela PissQuiz" Height="400" Width="600" Background="#FFF9F9F9">
    <StackPanel Margin="20" Background="Azure">

        <TextBlock x:Name="QuizTitle" 
                   FontSize="22" FontWeight="Bold" 
                   Foreground="HotPink" Margin="0,0,0,20"/>

        <TextBlock x:Name="QuestionText"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <StackPanel x:Name="AnswerOptions" Margin="0,0,0,20"/>

        <Button x:Name="SubmitButton" Content="Svara"
                Width="100" Height="40" Background="LightGreen"
                Click="SubmitButton_Click"/>

        <Button x:Name="NextButton" Content="Nästa fråga"
                Width="120" Height="40" Background="DarkBlue"
                Margin="0,10,0,0" Visibility="Collapsed"
                Click="NextButton_Click"/>

    </StackPanel>
</Window>
