<UserControl x:Class="PissQuiz.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Tomato">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Background="DarkGreen">

        <TextBlock Text="VÄLKOMMEN TILL PISSQUIZ" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0 0 0 40" 
                   HorizontalAlignment="Center"
                   Foreground="DeepPink"/>
        <Button x:Name="PlayButton" 
                Background="Black"
                Content="1. SPELA PISSQUIZ" 
                Click="PlayButtonClick" 
                Margin="10" 
                Padding="10" 
                FontSize="18"
                Foreground="AliceBlue"
                Height="45"/>

        <Button x:Name="CreateButton" 
                Background="BlueViolet"
                Content="2. SKAPA NYTT PISSQUIZ" 
                Click="CreateButtonClick" 
                Margin="10" 
                Padding="10" 
                FontSize="18"
                Foreground="LightCoral"
                Height="45"/>

        <Button x:Name="EditButton"
                Background="Aqua"
            Content="3. REDIGERA PISSQUIZ" 
            Click="EditButtonClick" 
            Margin="10" 
            Padding="10" 
            FontSize="18"
            Foreground="HotPink"
            Height="45"/>

    </StackPanel>
</UserControl>